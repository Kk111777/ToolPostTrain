# Python/runtime artifacts
.venv*/
hf_cache/
__pycache__/
*.py[cod]

# Training outputs and live logs
outputs/
wandb/
logs/
*.log

# Live run payloads. Curated reports/metrics may be copied out of runs/ and
# committed deliberately; the runs/ root itself remains visible to Git.
runs/*/checkpoints/
runs/*/model_only/
runs/*/logs/
runs/*/.rollout_capture/
runs/*/eval_generations/
runs/*/diagnostics/
runs/*/pre_hydra_failure/
runs/*/effective_config*.yaml
runs/*/command.txt
runs/*/run_status.json
runs/*/compact_rollouts.py
runs/*/*.log
runs/*/*.jsonl
runs/*/*.parquet

# Model weights and optimizer/trainer state
*.safetensors
*.bin
*.pt
*.pth
*.ckpt

# Raw/local datasets
*.parquet
verl-GDPO/dataset/rlla_4k/

# Local backup variants
*.pre_hydra_fix

# Credentials and private configuration
credentials*
*_token*
